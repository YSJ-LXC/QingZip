<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Surface" Background="#A6F3F7FB" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
  <Grid.Resources>
    <SolidColorBrush x:Key="Ink" Color="#233747"/>
    <SolidColorBrush x:Key="Muted" Color="#738294"/>
    <SolidColorBrush x:Key="Accent" Color="#128A7C"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontSize" Value="13"/></Style>
    <Style x:Key="Glass" TargetType="Border">
      <Setter Property="Background" Value="#AFFFFFFF"/><Setter Property="BorderBrush" Value="#E5FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="20"/>
    </Style>
    <Style x:Key="SoftButton" TargetType="Button">
      <Setter Property="Foreground" Value="#344C5E"/><Setter Property="Background" Value="#BFFFFFFF"/>
      <Setter Property="BorderBrush" Value="#F0FFFFFF"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="17,11"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" RenderTransformOrigin="0.5,0.5">
          <Border.RenderTransform><TransformGroup><ScaleTransform/><TranslateTransform/></TransformGroup></Border.RenderTransform>
          <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetName="Shell" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" To="-2" Duration="0:0:0.16"/>
            <DoubleAnimation Storyboard.TargetName="Shell" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1.025" Duration="0:0:0.16"/>
            <DoubleAnimation Storyboard.TargetName="Shell" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1.025" Duration="0:0:0.16"/>
          </Storyboard></BeginStoryboard></EventTrigger>
          <EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetName="Shell" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" To="0" Duration="0:0:0.22"/>
            <DoubleAnimation Storyboard.TargetName="Shell" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.22"/>
            <DoubleAnimation Storyboard.TargetName="Shell" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.22"/>
          </Storyboard></BeginStoryboard></EventTrigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.68"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.4"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#128A7C"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource SoftButton}"/>
    <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource SoftButton}">
      <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="18,15"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="Pill" TargetType="Border"><Setter Property="CornerRadius" Value="10"/><Setter Property="Background" Value="#D1EDE8"/><Setter Property="Padding" Value="10,5"/></Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="11,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Option" CornerRadius="7" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Option" Property="Background" Value="#D9EFEA"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Option" Property="Background" Value="#EAF4F1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ComboBox">
      <Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#344C5E"/><Setter Property="Padding" Value="9,8"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
        <ToggleButton x:Name="Toggle" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Face" CornerRadius="8" Background="#40FFFFFF"><Grid><TextBlock Text="⌄" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,3" Foreground="#718D98"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#B0FFFFFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton>
        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="9,8,23,8" IsHitTestVisible="False"/>
        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" CornerRadius="12" Background="#F7FCFB" BorderBrush="#DCE9E7" BorderThickness="1" Padding="5" Margin="0,5,0,0"><ScrollViewer MaxHeight="220"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
      </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Toggle" Property="Background" Value="#128A7C"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Row" Background="Transparent" CornerRadius="10" Margin="6,2" Padding="12,12"><ContentPresenter/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#75FFFFFF"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#BFD6F0EA"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#128A7C"/><Setter TargetName="Row" Property="BorderThickness" Value="1"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent" Width="8">
        <Track x:Name="PART_Track" IsDirectionReversed="True"><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border CornerRadius="3" Margin="2,0" Background="#608795A2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track>
      </Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Grid.Resources>
  <!-- Soft light is part of the fallback and remains visible when desktop transparency is disabled. -->
  <Grid IsHitTestVisible="False" ClipToBounds="True">
    <Ellipse Width="700" Height="650" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-260,-240,0,0" Fill="#608DE3D1"><Ellipse.Effect><BlurEffect Radius="100"/></Ellipse.Effect></Ellipse>
    <Ellipse Width="620" Height="620" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-260,-170,0" Fill="#70C7B9F0"><Ellipse.Effect><BlurEffect Radius="110"/></Ellipse.Effect></Ellipse>
    <Ellipse Width="640" Height="430" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-80,-210" Fill="#7591DEDE"><Ellipse.Effect><BlurEffect Radius="100"/></Ellipse.Effect></Ellipse>
  </Grid>
  <Grid Margin="20,12,20,20">
    <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid x:Name="TitleBar" Margin="12,0,2,0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="◈" Foreground="#128A7C" FontSize="20" Margin="0,0,9,0"/><TextBlock Text="轻ZIP" FontWeight="SemiBold"/><TextBlock Text=" /  让文件轻盈一点" Foreground="#738294" FontSize="11" Margin="12,2,0,0"/></StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
        <Button x:Name="MinimizeButton" Content="—" Width="38" Height="32" Padding="0" Background="Transparent" BorderBrush="Transparent" ToolTip="最小化" AutomationProperties.Name="最小化"/>
        <Button x:Name="MaximizeButton" Content="□" Width="38" Height="32" Padding="0" Background="Transparent" BorderBrush="Transparent" ToolTip="最大化或还原" AutomationProperties.Name="最大化或还原"/>
        <Button x:Name="CloseButton" Content="×" FontSize="19" Width="38" Height="32" Padding="0" Background="Transparent" BorderBrush="Transparent" ToolTip="关闭" AutomationProperties.Name="关闭"/>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Glass}" Background="#80FFFFFF" Padding="20,28,20,20">
        <Grid><Grid.RowDefinitions><RowDefinition Height="118"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel>
            <Border Width="48" Height="48" HorizontalAlignment="Left" CornerRadius="15" Background="#233E4D" Margin="0,0,0,14">
              <Grid><TextBlock Text="Z" Foreground="#D2F9ED" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="·" Foreground="#69DBB9" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,7,1" FontSize="26"/></Grid>
            </Border>
            <TextBlock Text="轻ZIP" FontSize="25" FontWeight="Bold"/><TextBlock Text="简单。轻快。有条理。" FontSize="11" Foreground="#738294" Margin="0,6,0,0"/>
          </StackPanel>
          <StackPanel Grid.Row="1" Margin="0,38,0,0">
            <TextBlock Text="工作空间" FontSize="10" Foreground="#8695A4" Margin="10,0,0,14"/>
            <Button x:Name="BrowseNav" Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Margin="0,0,13,0" VerticalAlignment="Center"/><TextBlock Text="浏览与解压" FontWeight="SemiBold"/></StackPanel></Button>
            <Button x:Name="CreateNav" Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Margin="0,0,13,0" VerticalAlignment="Center"/><TextBlock Text="创建 ZIP" FontWeight="SemiBold"/></StackPanel></Button>
          </StackPanel>
          <Border Grid.Row="3" Background="#65FFFFFF" BorderBrush="#A0FFFFFF" BorderThickness="1" CornerRadius="14" Padding="14">
            <StackPanel><TextBlock Text="文件留在你的电脑" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="本地处理 · 无需上传" Foreground="#738294" FontSize="10" Margin="0,6,0,13"/><TextBlock Text="Ctrl + O   打开 ZIP" Foreground="#8C9AA6" FontSize="10"/><TextBlock Text="Ctrl + N   创建 ZIP" Foreground="#8C9AA6" FontSize="10" Margin="0,5,0,0"/><TextBlock Text="GLASS EDITION  /  1.1" Foreground="#9AA7B0" FontSize="9" Margin="0,18,0,0"/></StackPanel>
          </Border>
        </Grid>
      </Border>
      <Grid x:Name="Page" Grid.Column="2" Margin="0,10,0,0">
        <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
        <Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="76"/><RowDefinition Height="90"/><RowDefinition Height="*"/><RowDefinition Height="100"/></Grid.RowDefinitions>
        <Grid><StackPanel><StackPanel Orientation="Horizontal"><TextBlock x:Name="PageTitle" Text="浏览与解压" FontSize="29" FontWeight="Bold"/><Border Style="{StaticResource Pill}" Margin="15,6,0,6" VerticalAlignment="Center"><TextBlock Text="ZIP" FontWeight="SemiBold" FontSize="10" Foreground="#298B7A"/></Border></StackPanel><TextBlock x:Name="Subtitle" Text="打开压缩包，让里面的文件一目了然。" Foreground="#738294" Margin="1,9,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Grid>
        <Grid Grid.Row="1" Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel x:Name="BrowseTools" Orientation="Horizontal" VerticalAlignment="Top">
            <Button x:Name="OpenButton"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" Margin="0,0,9,0" VerticalAlignment="Center"/><TextBlock Text="打开 ZIP" FontWeight="SemiBold"/></StackPanel></Button>
          </StackPanel>
          <StackPanel x:Name="CreateTools" Orientation="Horizontal" VerticalAlignment="Top" Visibility="Collapsed">
            <Button x:Name="FilesButton" Content="＋  添加文件" Margin="0,0,8,0" Padding="12,11"/>
            <Button x:Name="FolderButton" Content="添加文件夹" Margin="0,0,8,0" Padding="12,11"/>
            <Button x:Name="RemoveButton" Content="移除" Padding="12,11"/>
          </StackPanel>
          <Border Grid.Column="1" Style="{StaticResource Glass}" CornerRadius="12" VerticalAlignment="Top" Padding="4" Effect="{x:Null}" Margin="12,0,0,0">
            <Grid><ComboBox x:Name="EncodingBox" Width="150" BorderThickness="0" Background="Transparent" ToolTip="ZIP 文件名的文字编码" AutomationProperties.Name="文件名编码"><ComboBoxItem Content="文件名：自动识别"/><ComboBoxItem Content="文件名：UTF-8"/><ComboBoxItem Content="文件名：中文旧格式"/><ComboBoxItem Content="文件名：西文旧格式"/></ComboBox>
            <ComboBox x:Name="CompressionBox" Width="150" BorderThickness="0" Background="Transparent" Visibility="Collapsed" AutomationProperties.Name="压缩方式"><ComboBoxItem Content="标准压缩"/><ComboBoxItem Content="仅打包，不压缩"/></ComboBox></Grid>
          </Border>
        </Grid>
        <Grid Grid.Row="2" Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border x:Name="Card1" Style="{StaticResource Glass}" CornerRadius="15" Padding="16,10" Effect="{x:Null}"><Grid><TextBlock x:Name="CountLabel" Text="包内项目" Foreground="#7A8B99" FontSize="10" VerticalAlignment="Top"/><TextBlock x:Name="CountValue" Text="0" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Bottom"/><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Foreground="#91B9B2" FontSize="19" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
          <Border x:Name="Card2" Grid.Column="2" Style="{StaticResource Glass}" CornerRadius="15" Padding="16,10" Effect="{x:Null}"><Grid><TextBlock x:Name="SizeLabel" Text="原始大小" Foreground="#7A8B99" FontSize="10"/><TextBlock x:Name="SizeValue" Text="0 B" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Bottom"/><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Foreground="#A7A0C6" FontSize="19" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
          <Border x:Name="Card3" Grid.Column="4" Style="{StaticResource Glass}" CornerRadius="15" Padding="16,10" Effect="{x:Null}"><Grid><TextBlock x:Name="PackedLabel" Text="ZIP 大小" Foreground="#7A8B99" FontSize="10"/><TextBlock x:Name="PackedValue" Text="0 B" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Bottom"/><TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" Foreground="#90B4C4" FontSize="19" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
        </Grid>
        <Border Grid.Row="3" Style="{StaticResource Glass}" Background="#89FFFFFF" Padding="9,0,9,9">
          <Grid><Grid.RowDefinitions><RowDefinition Height="55"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="18,0,14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="106"/><ColumnDefinition Width="106"/></Grid.ColumnDefinitions>
              <TextBlock Text="名称" VerticalAlignment="Center" Foreground="#7A8B99" FontSize="11"/><TextBlock Grid.Column="1" Text="类型" VerticalAlignment="Center" Foreground="#7A8B99" FontSize="11"/><TextBlock Grid.Column="2" Text="原始大小" VerticalAlignment="Center" Foreground="#7A8B99" FontSize="11"/><TextBlock Grid.Column="3" Text="压缩后" VerticalAlignment="Center" Foreground="#7A8B99" FontSize="11"/>
              <Border Height="1" VerticalAlignment="Bottom" Grid.ColumnSpan="4" Background="#183B596D"/>
            </Grid>
            <ListBox x:Name="FileList" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectionMode="Extended" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" AutomationProperties.Name="文件列表">
              <ListBox.ItemTemplate><DataTemplate><Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="106"/><ColumnDefinition Width="106"/></Grid.ColumnDefinitions>
                <Grid Margin="0,0,12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="25" Height="29" Background="{Binding Tint}" CornerRadius="7" HorizontalAlignment="Left"><TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" Foreground="{Binding IconColor}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/></Border><TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" FontSize="12"/></Grid>
                <TextBlock Grid.Column="1" Text="{Binding Type}" Foreground="#8292A0" VerticalAlignment="Center" FontSize="11"/><TextBlock Grid.Column="2" Text="{Binding Size}" Foreground="#617688" VerticalAlignment="Center" FontSize="12"/><TextBlock Grid.Column="3" Text="{Binding Packed}" Foreground="#617688" VerticalAlignment="Center" FontSize="12"/>
              </Grid></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <Grid x:Name="EmptyPanel" Grid.Row="1" Background="Transparent">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,15">
                <Grid x:Name="EmptyIcon" Width="116" Height="115" Margin="0,0,0,14" RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                  <Ellipse Fill="#5ACFECE3" Width="106" Height="106"/>
                  <Border Width="69" Height="79" CornerRadius="18" Background="#DDFFFFFF" BorderBrush="White" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><RotateTransform Angle="-8"/></Border.RenderTransform><Border.Effect><DropShadowEffect Color="#5A948C" Opacity="0.15" BlurRadius="17" ShadowDepth="6"/></Border.Effect><Grid><Rectangle Width="8" Height="37" Fill="#83C2B2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,9,0,0"/><Border Width="16" Height="21" CornerRadius="5" BorderBrush="#419A85" BorderThickness="3" Margin="0,28,0,0"/></Grid></Border>
                  <Border Width="31" Height="31" CornerRadius="11" Background="#249885" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,5"><TextBlock Text="↓" Foreground="White" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                </Grid>
                <TextBlock x:Name="EmptyTitle" Text="把 ZIP 拖到这里" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptyHint" Text="或点击上方「打开 ZIP」，开始整理文件" Foreground="#8393A1" FontSize="12" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                <TextBlock Text="本地完成  ·  保留目录结构" Foreground="#9AA9B3" FontSize="10" Margin="0,19,0,0" HorizontalAlignment="Center"/>
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
        <Grid Grid.Row="4" Margin="0,18,0,0"><Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ResultButton" Content="打开结果" Margin="0,0,10,0" Visibility="Collapsed"/>
            <Button x:Name="CancelButton" Content="取消任务" Margin="0,0,10,0" Visibility="Collapsed"/>
            <Button x:Name="PrimaryButton" Content="解压到文件夹  →" Background="#244B55" Foreground="White" BorderBrush="#446C75" Padding="23,12" FontWeight="SemiBold" MinWidth="180"/>
          </StackPanel>
          <Grid Grid.Row="1" Margin="2,14,2,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Ellipse Width="5" Height="5" Fill="#329B83" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock x:Name="Status" Text="准备就绪" Foreground="#8394A2" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="490"/></StackPanel><Border x:Name="ProgressTrack" Grid.Column="1" Height="5" CornerRadius="3" Background="#C5DDD9" VerticalAlignment="Center" Visibility="Collapsed" ClipToBounds="True"><Grid><Border x:Name="ProgressFill" Background="#2E9A85" CornerRadius="3" HorizontalAlignment="Left" Width="0"/></Grid></Border></Grid>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Grid>
